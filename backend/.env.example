# ReGenRAG environment configuration.
# Copy to `.env` and fill in values. Never commit real secrets (`.env` is
# git-ignored).

# --- Application ------------------------------------------------------------
APP_NAME=ReGenRAG
APP_ENV=development

# --- Database ----------------------------------------------------------------
# PostgreSQL + pgvector URL of the main app database.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/regenrag
# Optional isolated database for tests. If omitted, tests derive
# "<DATABASE_NAME>_test" from DATABASE_URL automatically.
TEST_DATABASE_URL=

# --- LLM provider (configurable; e.g. openai, anthropic, ollama) -------------
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# --- Embeddings --------------------------------------------------------------
EMBEDDING_MODEL=
# Dimension of the pgvector embedding column. Align with the model chosen in a
# later phase; changing it requires a new migration.
EMBEDDING_DIMENSION=384

# --- Storage -----------------------------------------------------------------
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed

# --- RAG / session tuning ------------------------------------------------------
MAX_FILE_SIZE_MB=20
SESSION_TTL_MINUTES=60
MAX_RETRIES=3
RAG_TOP_K=5