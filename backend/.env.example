# ReGenRAG environment configuration.
# Copy to `.env` and fill in values. Never commit real secrets (`.env` is
# git-ignored).

# --- Application ------------------------------------------------------------
APP_NAME=ReGenRAG
APP_ENV=development

# --- Database ----------------------------------------------------------------
# PostgreSQL + pgvector URL of the main app database.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/regenrag
# Optional isolated database for tests. If omitted, tests derive
# "<DATABASE_NAME>_test" from DATABASE_URL automatically.
TEST_DATABASE_URL=

# --- LLM provider (configurable; e.g. openai, anthropic, ollama, gemini) -----
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# Base URL override. Empty uses the provider default: OpenAI, Ollama localhost,
# Anthropic, or Google Gemini (generativelanguage.googleapis.com/v1beta).
LLM_BASE_URL=
# Cap on tokens in a generated answer.
LLM_MAX_TOKENS=512

# --- Embeddings --------------------------------------------------------------
# Local sentence-transformers model, run on-device (no API key required).
# all-MiniLM-L6-v2 emits 384-dim vectors matching EMBEDDING_DIMENSION.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Dimension of the pgvector embedding column. Must match the model's actual
# output dimension (the embedder verifies this at load time). Changing it
# requires a new Alembic migration.
EMBEDDING_DIMENSION=384
# Batch size for encoding many chunks in a single model call.
EMBEDDING_BATCH_SIZE=32
# Seed applied at model load for deterministic embeddings.
EMBEDDING_SEED=42

# --- Chunking ----------------------------------------------------------------
# Character-based chunk window and overlap between consecutive chunks.
# CHUNK_OVERLAP must be >= 0 and strictly smaller than CHUNK_SIZE.
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Storage -----------------------------------------------------------------
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed

# --- RAG / session tuning ------------------------------------------------------
MAX_FILE_SIZE_MB=20
SESSION_TTL_MINUTES=60
MAX_RETRIES=3
RAG_TOP_K=5
# Minimum cosine similarity (1 - cosine distance) for a retrieved chunk to count
# as relevant evidence. Scores are in [0, 1]; higher is more relevant. Lower the
# threshold to grade more leniently, raise it to require stronger matches.
RETRIEVAL_SIMILARITY_THRESHOLD=0.65
# Maximum self-healing retries for the RAG pipeline (Phase 6).
# 0 = no retries (single attempt). 2 = initial + 2 retries = 3 total attempts.
MAX_RAG_RETRIES=2
# Minimum grounding score [0, 1] for an answer to be considered grounded.
# Phase 5 grounding evaluator produces scores in this range.
GROUNDING_THRESHOLD=0.7